{
  "name": "@3dspace/avatar-bodies",
  "version": "0.1.0",
  "private": true,
  "description": "Avatar body catalog data and types.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "development": "./src/browser.ts",
      "import": "./dist/src/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-esm-imports.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@3dspace/contracts": "0.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "typescript": "^5.5.2"
  }
}
