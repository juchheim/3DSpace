# 3DSpace environment template
# Copy to `.env.local` at the repository root for local development:
#   cp .env.example .env.local
#
# Authoritative matrix (platform, required, defaults, status): docs/planning/mvp/MVP_STATUS.md
# Production deployment steps: docs/planning/mvp/DEPLOYMENT_CHECKLIST.md
#
# App-specific subsets:
#   apps/api/.env.example  — backend (Koyeb)
#   apps/web/.env.example  — frontend (Vercel)

# --- Runtime ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# --- Public URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production examples:
# CORS_ALLOWED_ORIGINS=https://3d-space-seven.vercel.app,https://*.vercel.app

# --- Google SSO / first-party auth (leave empty locally for dev identity headers) ---
NEXT_PUBLIC_AUTH_REQUIRED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AUTH_JWT_SECRET=
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_GOOGLE_HOSTED_DOMAIN_HINT=
AUTH_JWT_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_EXCHANGE_TTL_SECONDS=60
AUTH_OAUTH_STATE_TTL_SECONDS=600

# --- MongoDB Atlas (leave empty locally to use in-memory repository) ---
MONGODB_URI=
MONGODB_DB_NAME=3dspace

# --- LiveKit (leave empty locally for multi-tab BroadcastChannel fallback) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# --- World skin operator uploader (optional; enables /dev/world-skin-upload + API routes) ---
WORLD_SKIN_UPLOADER_PASSWORD=WORLD_SKIN_UPLOADER_PASSWORD
NEXT_PUBLIC_ENABLE_WORLD_SKIN_UPLOADER=true

# --- S3-compatible object storage (leave empty locally for deterministic dev URLs) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
# Set to true only when the bucket/CDN at OBJECT_STORAGE_PUBLIC_BASE_URL allows anonymous GET.
OBJECT_STORAGE_PUBLIC_READ=false

# --- Session / room tuning (backend) ---
AVATAR_STATE_SEND_HZ=12
AVATAR_INTERPOLATION_MS=120
MAX_ROOM_PARTICIPANTS=30
SESSION_JOIN_RATE_LIMIT_PER_MINUTE=20

# --- Client defaults (also used by Next.js build when set on Vercel) ---
DEFAULT_VIEW_MODE=3d
DEFAULT_3D_QUALITY=low
ENABLE_2D_ANALOG=true
ENABLE_WALL_ATTACHMENTS=true
ENABLE_WALL_OBJECTS=true
WALL_OBJECT_CREATION_DEFAULT=teacher-only
WALL_OBJECT_MAX_ACTIVE_PER_ROOM=20
WALL_OBJECT_MAX_ACTIVE_LIVE_SHARES=4
WALL_OBJECT_MAX_IMAGE_BYTES=10485760
WALL_OBJECT_MAX_VIDEO_BYTES=262144000
WALL_OBJECT_MAX_AUDIO_BYTES=52428800
WALL_OBJECT_ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp
WALL_OBJECT_ALLOWED_VIDEO_TYPES=video/mp4,video/webm
WALL_OBJECT_ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp4,audio/wav,audio/webm
ENABLE_WALL_WEB_LINKS=true
ENABLE_WALL_WEB_EMBEDS=false
WALL_WEB_EMBED_ALLOWLIST=
ENABLE_WALL_SCREEN_SHARE=true
ENABLE_WALL_STUDENT_UPLOADS=false
ENABLE_WALL_STUDENT_LIVE_SHARES=false
ENABLE_CLASSROOM_LESSONS=false
ENABLE_BREAKOUT_PODS=false
ENABLE_ROOM_OBJECTS=false
ENABLE_WORKFORCE_TRAINING=false
ENABLE_FREE_FOR_ALL=false
ENABLE_FREE_FOR_ALL_BUILDING=false
# Avatar physics (Free-for-All only, default off until staging)
ENABLE_PHYSICS=false
PHYSICS_GRAVITY=24
PHYSICS_MOVE_SPEED=3.2
PHYSICS_JUMP_HEIGHT=1.3
PHYSICS_MAX_FALL_SPEED=40
PHYSICS_AIR_CONTROL=0.6
PHYSICS_COYOTE_TIME_MS=120
PHYSICS_CAPSULE_RADIUS=0.4
PHYSICS_CAPSULE_HEIGHT=1.6
PHYSICS_MAX_SLOPE_CLIMB_DEG=50
PHYSICS_AUTO_STEP_HEIGHT=0.6
PHYSICS_SNAP_TO_GROUND_DIST=0.3
# Escape Room room type (empty canvas + world-building + dynamic boards; default off until staging)
ENABLE_ESCAPE_ROOM=false
BUILD_PLACEMENT_RATE_LIMIT_PER_MINUTE=600
FREE_FOR_ALL_PASSWORD=
ENABLE_AI_MEETING_NOTES=false
# AI World Host (Free-for-All retro-robot guide; default off until staging)
ENABLE_AI_WORLD_HOST=false
# Avatar accessories (catalog GLB attachments on Azure Vanguard; default off until staging)
ENABLE_AVATAR_ACCESSORIES=false
OPENAI_AI_HOST_MODEL=gpt-4.1-mini
OPENAI_AI_HOST_MODEL_LARGE=gpt-4.1
AI_WORLD_HOST_STORAGE_PREFIX=ai-host/
AI_WORLD_HOST_MAX_FILES_PER_ROOM=10
AI_WORLD_HOST_MAX_FILE_BYTES=5242880
# Return canned (no-OpenAI) chat replies — for tests / local UI without an API key.
AI_WORLD_HOST_MOCK_RESPONSES=false
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SUMMARY_MODEL=gpt-4.1
AI_MEETING_NOTES_MAX_DURATION_MINUTES=120
AI_MEETING_NOTES_STORAGE_PREFIX=meeting-notes/
ENABLE_WHITEBOARDS=true
WHITEBOARD_COMPACTION_TICK_SECONDS=30
WHITEBOARD_SNAPSHOT_AT_STROKES=500
WHITEBOARD_MAX_POINTS_PER_STROKE=2000
WHITEBOARD_MAX_ACTIVE_PER_ROOM=4
WHITEBOARD_STORAGE_PREFIX=whiteboards/
ENABLE_SHARED_BROWSERS=false
SHARED_BROWSER_VIEWPORT_WIDTH=1280
SHARED_BROWSER_VIEWPORT_HEIGHT=720
SHARED_BROWSER_MAX_ACTIVE_PER_ROOM=2
SHARED_BROWSER_IDLE_PAUSE_MINUTES=15
SHARED_BROWSER_MAX_NAVIGATIONS_PER_USER_PER_MINUTE=20
SHARED_BROWSER_BLOCKED_HOST_SUFFIXES=
SHARED_BROWSER_LAZY_START=true
SHARED_BROWSER_PAUSE_WHEN_ROOM_EMPTY=true
# Hyperbeam (required in production when ENABLE_SHARED_BROWSERS=true)
HYPERBEAM_API_KEY=
HYPERBEAM_API_BASE=https://engine.hyperbeam.com
SHARED_BROWSER_HYPERBEAM_QUALITY=sharp
SHARED_BROWSER_HYPERBEAM_FRAMERATE=30
SHARED_BROWSER_HYPERBEAM_REGION=

# --- AI 3D Object Generator (Free-for-All) ---
ENABLE_AI_OBJECT_GENERATION=false
AI_OBJECT_PROVIDER=procedural
MESHY_API_KEY=
OPENAI_AI_OBJECT_COMPOSER_MODEL=gpt-4.1
AI_OBJECT_MESHY_REFINE_TEXTURES=true
AI_OBJECT_STORAGE_PREFIX=ai-objects/
AI_OBJECT_MAX_PROMPT_CHARS=500
AI_OBJECT_MESHY_TIMEOUT_SEC=300
AI_OBJECT_MAX_JOBS_PER_USER_PER_DAY=20
AI_OBJECT_RETENTION_DAYS=30
AI_OBJECT_USE_TEST_FIXTURE=false

ENABLE_WORLD_SKINS=false
ENABLE_STUDENT_MEDIA_PERMISSIONS=false
NEXT_PUBLIC_ENABLE_WALL_OBJECTS=true
NEXT_PUBLIC_ENABLE_WALL_WEB_LINKS=true
NEXT_PUBLIC_ENABLE_WALL_WEB_EMBEDS=false
NEXT_PUBLIC_ENABLE_WALL_SCREEN_SHARE=true
NEXT_PUBLIC_ENABLE_CLASSROOM_LESSONS=false
NEXT_PUBLIC_ENABLE_BREAKOUT_PODS=false
NEXT_PUBLIC_ENABLE_ROOM_OBJECTS=false
NEXT_PUBLIC_ENABLE_WORKFORCE_TRAINING=false
NEXT_PUBLIC_ENABLE_FREE_FOR_ALL=false
NEXT_PUBLIC_ENABLE_FREE_FOR_ALL_BUILDING=false
# Avatar physics (Free-for-All only, default off until staging)
NEXT_PUBLIC_ENABLE_PHYSICS=false
NEXT_PUBLIC_PHYSICS_GRAVITY=24
NEXT_PUBLIC_PHYSICS_MOVE_SPEED=3.2
NEXT_PUBLIC_PHYSICS_JUMP_HEIGHT=1.3
NEXT_PUBLIC_PHYSICS_MAX_FALL_SPEED=40
NEXT_PUBLIC_PHYSICS_AIR_CONTROL=0.6
NEXT_PUBLIC_PHYSICS_COYOTE_TIME_MS=120
NEXT_PUBLIC_PHYSICS_CAPSULE_RADIUS=0.4
NEXT_PUBLIC_PHYSICS_CAPSULE_HEIGHT=1.6
NEXT_PUBLIC_PHYSICS_MAX_SLOPE_CLIMB_DEG=50
NEXT_PUBLIC_PHYSICS_AUTO_STEP_HEIGHT=0.6
NEXT_PUBLIC_PHYSICS_SNAP_TO_GROUND_DIST=0.3
# Escape Room room type (empty canvas + world-building + dynamic boards; default off until staging)
NEXT_PUBLIC_ENABLE_ESCAPE_ROOM=false
NEXT_PUBLIC_ENABLE_AI_MEETING_NOTES=false
NEXT_PUBLIC_ENABLE_AI_WORLD_HOST=false
# Avatar accessories (editor section + 3D render layer; default off until staging)
NEXT_PUBLIC_ENABLE_AVATAR_ACCESSORIES=false
# GLB avatar recolor (neutral albedo + zone mask shader; default off until staging)
NEXT_PUBLIC_ENABLE_AVATAR_GLB_RECOLOR=false
NEXT_PUBLIC_ENABLE_LIVE_CAPTIONS=false
NEXT_PUBLIC_ENABLE_AI_OBJECT_GENERATION=false
NEXT_PUBLIC_ENABLE_WHITEBOARDS=true
NEXT_PUBLIC_ENABLE_SHARED_BROWSERS=false
NEXT_PUBLIC_SHARED_BROWSER_HYPERBEAM_REGION=
NEXT_PUBLIC_SHARED_BROWSER_HYPERBEAM_PLAYOUT_DELAY=false
NEXT_PUBLIC_ENABLE_WORLD_SKINS=false
NEXT_PUBLIC_ENABLE_STUDENT_MEDIA_PERMISSIONS=false

# --- Spatial audio ---
SPATIAL_AUDIO_ENABLED=true
SPATIAL_AUDIO_DISTANCE_MODEL=inverse
SPATIAL_AUDIO_REF_DISTANCE=1
SPATIAL_AUDIO_MAX_DISTANCE=24
SPATIAL_AUDIO_ROLLOFF_FACTOR=1.4

# --- Media capture defaults ---
MEDIA_DEFAULT_CAMERA_ENABLED=false
MEDIA_DEFAULT_MIC_ENABLED=false
MEDIA_MAX_VIDEO_WIDTH=640
MEDIA_MAX_VIDEO_HEIGHT=360
MEDIA_MAX_VIDEO_FPS=15

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
