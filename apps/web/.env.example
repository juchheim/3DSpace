# @3dspace/web — frontend environment (Vercel / local Next.js)
# Full template: ../../.env.example
# Status matrix: ../../docs/planning/mvp/MVP_STATUS.md

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# From the same Clerk app in the dashboard — do not use the docs sample pk_test_verified-python key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Required for Clerk middleware on the Next.js server (must pair with the publishable key above).
CLERK_SECRET_KEY=
# Optional overrides (defaults use NEXT_PUBLIC_APP_URL + /sign-in and /sign-up):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=http://127.0.0.1:3000/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=http://127.0.0.1:3000/sign-up
NEXT_PUBLIC_LIVEKIT_URL=

DEFAULT_VIEW_MODE=3d
DEFAULT_3D_QUALITY=low
NEXT_PUBLIC_ENABLE_WALL_OBJECTS=true
NEXT_PUBLIC_ENABLE_WALL_WEB_LINKS=true
NEXT_PUBLIC_ENABLE_WALL_WEB_EMBEDS=false
NEXT_PUBLIC_ENABLE_WALL_SCREEN_SHARE=true
NEXT_PUBLIC_ENABLE_CLASSROOM_LESSONS=false
NEXT_PUBLIC_ENABLE_BREAKOUT_PODS=false
NEXT_PUBLIC_ENABLE_ROOM_OBJECTS=false
NEXT_PUBLIC_ENABLE_WORKFORCE_TRAINING=false
NEXT_PUBLIC_ENABLE_FREE_FOR_ALL=false
NEXT_PUBLIC_ENABLE_FREE_FOR_ALL_BUILDING=false
# Avatar physics (Free-for-All only, default off until staging)
NEXT_PUBLIC_ENABLE_PHYSICS=false
NEXT_PUBLIC_PHYSICS_GRAVITY=24
NEXT_PUBLIC_PHYSICS_MOVE_SPEED=3.2
NEXT_PUBLIC_PHYSICS_JUMP_HEIGHT=1.3
NEXT_PUBLIC_PHYSICS_MAX_FALL_SPEED=40
NEXT_PUBLIC_PHYSICS_AIR_CONTROL=0.6
NEXT_PUBLIC_PHYSICS_COYOTE_TIME_MS=120
NEXT_PUBLIC_PHYSICS_CAPSULE_RADIUS=0.4
NEXT_PUBLIC_PHYSICS_CAPSULE_HEIGHT=1.6
NEXT_PUBLIC_PHYSICS_MAX_SLOPE_CLIMB_DEG=50
NEXT_PUBLIC_PHYSICS_AUTO_STEP_HEIGHT=0.6
NEXT_PUBLIC_PHYSICS_SNAP_TO_GROUND_DIST=0.3
# Escape Room room type (empty canvas + world-building + dynamic boards; default off until staging)
NEXT_PUBLIC_ENABLE_ESCAPE_ROOM=false
NEXT_PUBLIC_ENABLE_AI_MEETING_NOTES=false
NEXT_PUBLIC_ENABLE_LIVE_CAPTIONS=false
NEXT_PUBLIC_ENABLE_AI_OBJECT_GENERATION=false
NEXT_PUBLIC_ENABLE_WHITEBOARDS=true
NEXT_PUBLIC_ENABLE_SHARED_BROWSERS=false
NEXT_PUBLIC_SHARED_BROWSER_HYPERBEAM_REGION=
# Optional: smoother motion at the cost of latency (Hyperbeam playoutDelay).
NEXT_PUBLIC_SHARED_BROWSER_HYPERBEAM_PLAYOUT_DELAY=false
NEXT_PUBLIC_ENABLE_WHISPER=false
NEXT_PUBLIC_ENABLE_WORLD_SKINS=false
NEXT_PUBLIC_ENABLE_WORLD_SKIN_DEV=false
NEXT_PUBLIC_ENABLE_STUDENT_MEDIA_PERMISSIONS=false
NEXT_PUBLIC_ENABLE_WORLD_SKIN_UPLOADER=false

NEXT_PUBLIC_SENTRY_DSN=

# Production (Vercel) typically also set:
# NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_API_URL, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY,
# NEXT_PUBLIC_LIVEKIT_URL
